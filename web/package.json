{
  "name": "volleyball-motion-tracker-web",
  "version": "0.1.0",
  "private": true,
  "description": "In-browser volleyball skeleton tracking: upload a clip, get tracked 2D skeletons for every player and the ball. No server compute.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p ../deploy/cloudflare/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --project unit --project dom",
    "test:watch": "vitest --project unit --project dom",
    "test:browser": "vitest run --project browser",
    "test:perf": "vitest run --project perf",
    "test:harness": "vitest run --project harness",
    "test:e2e": "playwright test",
    "fetch-models": "node scripts/fetch-models.mjs",
    "cf:dev": "wrangler dev --config ../deploy/cloudflare/wrangler.jsonc --persist-to ../deploy/cloudflare/.wrangler/state",
    "cf:seed-local": "node scripts/cf-seed-local.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@use-gesture/react": "10.3.1",
    "@xstate/react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.66.0",
    "mediabunny": "1.65.0",
    "motion": "14.9.0",
    "munkres": "2.1.1",
    "onnxruntime-common": "1.31.1",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2",
    "workbox-window": "7.4.1",
    "xstate": "5.33.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261101.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@webgpu/types": "0.1.74",
    "ajv": "8.20.0",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "onnxruntime-node": "1.31.1",
    "playwright": "1.64.1",
    "shadcn": "4.23.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
